{
  "expo": {
    "name": "NOVA AI",
    "slug": "nova-mobile",
    "scheme": "nova",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070C16",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/tenderpilot-logo.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#010E29"
        }
      ],
      "expo-image",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "NOVA uses the camera to scan IDs, certificates and tender documents into your TenderPilot AI documents.",
          "photosPermission": "NOVA uses your photos so you can add pictures of documents you have already taken."
        }
      ]
    ]
  }
}
